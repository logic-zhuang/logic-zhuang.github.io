---
import Layout from '../layouts/Layout.astro';

const skillCategories = [
  {
    title: 'AI 应用',
    subtitle: 'AI APPLICATIONS',
    skills: [
      { name: 'LangGraph / RAG', desc: '检索增强问答：文档切分、混合检索、工具调用与会话检查点。', level: 'proficient', link: '/projects/ai-knowledge-base/', linkText: '实践项目 →' },
      { name: 'Chroma / BM25 / RRF', desc: '向量检索与混合检索融合，自建评测集对照检索效果。', level: 'proficient', link: '/projects/ai-knowledge-base/', linkText: '实践项目 →' },
      { name: 'FastAPI', desc: 'RESTful 接口开发，接口与异常场景测试。', level: 'familiar', link: '/projects/ai-knowledge-base/', linkText: '实践项目 →' },
    ],
  },
  {
    title: '自动化与工程',
    subtitle: 'AUTOMATION & ENGINEERING',
    skills: [
      { name: 'Playwright', desc: '网页自动化、元素定位、操作审核。', level: 'proficient', link: '/projects/automation-skills/', linkText: '实践项目 →' },
      { name: 'pywin32 / COM', desc: 'Word / WPS / Excel 等桌面应用自动化驱动。', level: 'proficient', link: '/projects/automation-skills/', linkText: '实践项目 →' },
      { name: 'Git', desc: '分支管理、远程协作、版本快照管理。', level: 'proficient', link: 'https://github.com/logic-zhuang', linkText: 'GitHub →' },
      { name: 'Linux', desc: '命令行操作、服务器配置、环境部署、Shell 脚本。', level: 'familiar', link: 'https://github.com/logic-zhuang', linkText: 'GitHub →' },
    ],
  },
  {
    title: '编程与数据',
    subtitle: 'PROGRAMMING & DATA',
    skills: [
      { name: 'Python', desc: '数据处理、自动化脚本、算法调优、RAG 应用开发。', level: 'proficient', link: '/projects/ai-knowledge-base/', linkText: '实践项目 →' },
      { name: 'SQL / MySQL', desc: '复杂查询、多表关联、数据清洗与聚合统计。', level: 'proficient', link: '/projects/ai-knowledge-base/', linkText: '实践项目 →' },
      { name: 'Pandas / NumPy', desc: '数据处理与数值计算核心库。', level: 'proficient', link: '/projects/fitness-miniprogram/', linkText: '数据统计 →' },
      { name: 'Stata / Excel', desc: '统计分析、回归建模、数理统计方法应用。', level: 'proficient' },
    ],
  },
  {
    title: '前端开发',
    subtitle: 'FRONTEND',
    skills: [
      { name: '微信小程序', desc: 'WXML / WXSS / JavaScript 原生开发，训练打卡小程序。', level: 'proficient', link: '/projects/fitness-miniprogram/', linkText: '实践项目 →' },
      { name: 'HTML / CSS / JS', desc: '页面结构与样式设计，交互逻辑。', level: 'proficient' },
    ],
  },
];
---

<Layout title="技能">
  <div class="container">
    <section class="hero" style="padding-bottom: 32px;">
      <div class="hero-badge">
        <span class="dot"></span>
        <span>SKILLS</span>
      </div>
      <h1 style="font-size: 36px;">技能</h1>
      <p class="subtitle" style="margin-top: 16px;">
        统计学背景 + AI 应用开发。每项技能尽量关联到对应项目或成果，可点击查看实践。
      </p>
      <div class="skills-legend" style="margin-top: 20px;">
        <span class="legend-item"><span class="legend-dot proficient"></span>熟练 · 主力使用</span>
        <span class="legend-item"><span class="legend-dot familiar"></span>基础 · 可独立开发</span>
      </div>
    </section>

    <!-- Profile Card -->
    <div class="skills-hero-card">
      <div class="icon-box">📊</div>
      <div class="content">
        <h3>统计学背景 <span class="level-badge proficient" style="margin-left: 8px;">核心优势</span></h3>
        <p>
          中国石油大学（北京）克拉玛依校区 统计学本科，GPA 3.58 / 5.0，百分制均分 85+。
          具备数学分析、概率论、数理统计、回归分析、数学建模等系统训练，
          能从统计视角分析数据与算法效果——这是 AI 应用与算法工程中的差异化优势。
        </p>
      </div>
    </div>

    <div class="skills-grid">
      {skillCategories.map((cat) => (
        <div class="skill-category">
          <div class="cat-header">
            <div class="cat-title">{cat.title}</div>
            <div class="cat-subtitle">{cat.subtitle}</div>
          </div>
          {cat.skills.map((skill) => (
            <div class="skill-item">
              <div class="skill-main">
                <div class="skill-name">{skill.name}</div>
                <div class="skill-desc">{skill.desc}</div>
                {skill.link && (
                  <a class="skill-link" href={skill.link} target={skill.link.startsWith('http') ? '_blank' : undefined} rel={skill.link.startsWith('http') ? 'noopener' : undefined}>
                    {skill.linkText}
                  </a>
                )}
              </div>
              <span class={`level-badge ${skill.level}`}>
                {skill.level === 'proficient' ? '熟练' : '基础'}
              </span>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</Layout>
