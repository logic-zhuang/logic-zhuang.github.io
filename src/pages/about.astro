---
import Layout from '../layouts/Layout.astro';
---

<Layout title="关于我 · 你的名字">
  <h1 style="margin-bottom: 32px;">关于我</h1>

  <section class="about-section">
    <h2>教育背景</h2>
    <div class="experience-item">
      <div class="exp-title">中国石油大学（北京）克拉玛依校区</div>
      <div class="exp-org">统计学 · 本科 · 2024 — 2028</div>
      <p class="exp-desc">
        专业排名 10/65，核心课程涵盖概率论、数理统计、多元统计分析、随机过程、统计计算等。
        关注 AI 应用工程化方向，课余自学 LangChain、Docker、Linux 集群运维等技术栈。
      </p>
    </div>
  </section>

  <section class="about-section">
    <h2>技术栈</h2>
    <div class="skill-list">
      <span class="tag">Python</span>
      <span class="tag">C/C++</span>
      <span class="tag">LangChain</span>
      <span class="tag">RAG / 向量检索</span>
      <span class="tag">Dify</span>
      <span class="tag">Docker</span>
      <span class="tag">Linux / CentOS</span>
      <span class="tag">SSH / 集群运维</span>
      <span class="tag">FastAPI</span>
      <span class="tag">Playwright</span>
      <span class="tag">LaTeX</span>
      <span class="tag">SQL</span>
    </div>
  </section>

  <section class="about-section">
    <h2>实习经历</h2>
    <div class="experience-item">
      <div class="exp-title">驻地开发实习生</div>
      <div class="exp-org">幺米动态科技有限公司 · 2025.07 — 2025.09</div>
      <p class="exp-desc">
        参与企业内部业务系统的开发与维护工作，负责需求沟通、后端接口开发、测试用例编写与文档整理。
      </p>
    </div>
  </section>

  <section class="about-section">
    <h2>竞赛与获奖</h2>
    <div class="experience-item">
      <div class="exp-title">全国大学生数学建模竞赛</div>
      <div class="exp-org">2026 · C 题《微网与外部电网电力调控策略》</div>
      <p class="exp-desc">构建多目标优化模型，完成建模、编程求解与论文撰写全流程。</p>
    </div>
    <div class="experience-item">
      <div class="exp-title">先进机器人及仿真技术大赛 · 通义千问应用挑战组</div>
      <div class="exp-org">第十九届 · 冻土消融公众传播方向</div>
      <p class="exp-desc">基于大模型设计科普互动对话，负责内容策划与 Prompt 工程。</p>
    </div>
  </section>

  <section class="about-section">
    <h2>联系我</h2>
    <p>📧 Email: your-email@example.com</p>
    <p>💻 GitHub: <a href="https://github.com/your-username" target="_blank" rel="noopener">github.com/your-username</a></p>
    <p>📍 坐标：新疆克拉玛依 / 求职意向：深圳 · 广州 · AI 应用开发实习</p>
  </section>
</Layout>
