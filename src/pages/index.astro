---
import Layout from '../layouts/Layout.astro';

const honors = [
  { name: '全国大学生数学竞赛', detail: '赛区一等奖' },
  { name: '正大杯统计调研大赛', detail: '二等奖' },
  { name: '蓝桥杯 Python 组', detail: '三等奖' },
  { name: '校级一等奖学金', detail: '2025' },
  { name: '三好学生', detail: '2025' },
];

const featuredProjects = [
  {
    tag: 'AI 应用 · RAG',
    title: 'AI Agent 检索问答项目（LangGraph + RAG）',
    summary: '独立开发的私有知识库问答系统：文档切分、Chroma 向量检索与 BM25+RRF 混合检索，基于 LangGraph 实现工具调用与会话检查点，FastAPI 接口 + Streamlit 界面。',
    tags: ['LangGraph', 'Chroma', 'RAG', 'FastAPI', 'Streamlit'],
    detail: '/projects/ai-knowledge-base/',
    repo: 'https://github.com/logic-zhuang/knowledge-base-rag',
  },
  {
    tag: '自动化 · Agent 技能',
    title: '网页与桌面 Agent Skills 开发（web-rip / desktop-rip）',
    summary: '为团队 OpenDesk 应用制作网页与桌面自动化技能：Playwright 实现网页扫描与操作审核，COM 驱动 Word/WPS/Excel、命令窗口驱动 Stata；技能已配置到团队 OpenDesk 运行，并通过团队开放平台分发下载。',
    tags: ['Python', 'Playwright', 'pywin32 / COM', 'Skill 开发'],
    detail: '/projects/automation-skills/',
    repo: 'https://github.com/logic-zhuang/agent-skills-automation',
  },
  {
    tag: '微信小程序',
    title: '训练手记 · 健身打卡小程序',
    summary: '以 AI 协作工作流完成的全栈小程序：ChatGPT 写设计与说明文档 → 提示词 + Google Stitch 生成前端 → Agent 按 instruction.md 实现后端与数据库 → Agent 自动测试（Playwright 模拟真机）→ 人工验收。覆盖每周计划、训练打卡、统计与账号同步。',
    tags: ['微信小程序', 'FastAPI', 'AI 工作流', 'Playwright'],
    detail: '/projects/fitness-miniprogram/',
    repo: 'https://github.com/logic-zhuang/fitness-training-miniprogram',
  },
];

const researchInterests = [
  {
    title: '检索增强生成（RAG）与大模型应用',
    desc: '混合检索（向量 + BM25 + RRF）、检索评测集构建、弱证据场景下的人工确认与 Agent 恢复机制。',
  },
  {
    title: 'AI 自动化与智能体（Agent）',
    desc: '网页与桌面自动化技能封装、统一输入输出接口设计、复杂工作流的技能组合。',
  },
  {
    title: '统计建模与数据分析',
    desc: '回归分析与统计建模、实验效果评估、以数据驱动算法调参与决策。',
  },
];

const experiences = [
  {
    title: '驻地开发实习生',
    org: '幺米动态科技有限公司 · 体育中考自动化评测系统',
    period: '2026.07 - 2026.08',
    points: [
      '搭建面向多类体育测评任务的 AI 算法自动优化框架，统一候选算法修改、评估与结果比较流程，支持计数与测距任务复用。',
      '通过统一提示词与实验流程引导 AI 调参、分析异常样本，自动记录指标并保留评估集上最优算法版本，关联 Git 与代码快照支持回溯。',
      '支撑跳远算法 90 余版迭代；据同事测试反馈，测距精度约 2 厘米，跳绳多数测试视频计数误差在 2 次以内。',
    ],
  },
];
---

<Layout title="卢嘉淇 · 统计学背景的 AI 应用开发者">
  <div class="container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-badge">
        <span class="dot"></span>
        <span>求职 · 研究生申请中</span>
      </div>
      <h1>卢嘉淇 <span class="hero-sub">Jiaqi Lu</span></h1>
      <p class="subtitle">
        中国石油大学（北京）克拉玛依校区 · 统计学本科在读（211 / 双一流），GPA 3.58/5.0（百分制均分 85+）。
        统计学背景的 <strong>AI 应用开发者</strong>，方向聚焦 AI 应用开发、数据分析与算法工程；
        有体育评测算法实习与 RAG、自动化技能等真实项目实践。
      </p>
      <div class="tags">
        <span class="tag">Python</span>
        <span class="tag">LangGraph / RAG</span>
        <span class="tag">数据分析</span>
        <span class="tag">SQL</span>
        <span class="tag">Linux</span>
        <span class="tag">Git</span>
        <span class="tag">微信小程序</span>
        <span class="tag">Playwright</span>
      </div>
      <div class="hero-actions">
        <a href="/projects/" class="btn btn-primary">
          <span>查看项目</span>
          <span>→</span>
        </a>
        <a href="/resume.pdf" class="btn btn-secondary" target="_blank" rel="noopener">
          <span>下载简历 PDF</span>
        </a>
        <a href="/about/" class="btn btn-secondary">
          <span>关于我 / 联系我</span>
        </a>
      </div>
      <div class="hero-contact">
        <span>📧 2374493946@qq.com</span>
        <span>·</span>
        <a href="https://github.com/logic-zhuang" target="_blank" rel="noopener">GitHub: logic-zhuang</a>
      </div>
    </section>

    <!-- Honors -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">荣誉与奖项</h2>
          <p class="section-desc">竞赛与奖学金（完整列表见关于页）</p>
        </div>
        <a href="/about/" class="section-link">
          <span>关于我</span>
          <span>→</span>
        </a>
      </div>
      <div class="honor-grid">
        {honors.map((h) => (
          <div class="honor-item">
            <strong>{h.name}</strong>
            <span>{h.detail}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Research Interests -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">研究兴趣</h2>
          <p class="section-desc">面向研究生申请，基于实际项目经历</p>
        </div>
      </div>
      <div class="interest-grid">
        {researchInterests.map((r) => (
          <div class="interest-card">
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">代表项目</h2>
          <p class="section-desc">独立开发 / 深度参与的真实项目</p>
        </div>
        <a href="/projects/" class="section-link">
          <span>查看全部</span>
          <span>→</span>
        </a>
      </div>
      <div class="project-grid">
        {featuredProjects.map((p) => (
          <div class="project-card">
            <div class="card-header">
              <span class="card-tag">{p.tag}</span>
            </div>
            <h3>{p.title}</h3>
            <p class="card-desc">{p.summary}</p>
            <div class="card-tags">
              {p.tags.map((t) => <span>{t}</span>)}
            </div>
            <div class="card-footer">
              <a href={p.detail}>项目详情 →</a>
              <a href={p.repo} target="_blank" rel="noopener">GitHub</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">实习经历</h2>
        </div>
      </div>
      {experiences.map((exp) => (
        <div class="experience-item">
          <div class="exp-title">{exp.title}</div>
          <div class="exp-org">{exp.org} · {exp.period}</div>
          <ul class="exp-points">
            {exp.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <!-- CTA Banner -->
    <section class="cta-banner">
      <div>
        <h3>求职与研究生申请中</h3>
        <p>方向：AI 应用开发 / 数据分析 / 算法工程（实习、就业或研究生项目）。欢迎通过邮箱或 GitHub 联系。</p>
      </div>
      <a href="/about/" class="btn btn-primary">
        <span>联系我 →</span>
      </a>
    </section>
  </div>
</Layout>
