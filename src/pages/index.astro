---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featuredProjects = [
  {
    title: '个人知识库 AI 问答助手',
    description: '基于 LangChain + RAG 架构的私有知识库问答系统。支持多格式文档解析、语义切分、向量检索与多轮对话管理，Docker 容器化部署。',
    tags: ['Python', 'LangChain', 'RAG', 'ChromaDB', 'FastAPI', 'Docker'],
    link: '/projects/ai-knowledge-base',
    highlight: true,
  },
  {
    title: 'OpenDesk — 个人桌面工具集',
    description: '面向个人使用场景开发的桌面自动化工具平台，集成浏览器操控、文件处理、桌面操作等常用能力，支持自定义扩展。',
    tags: ['Python', '桌面自动化', '工具开发', '插件架构'],
    link: '/projects/opendesk',
  },
  {
    title: '浏览器自动化 & Skill 制作',
    description: '基于 Playwright 与 browser-use 开发浏览器自动化脚本，并封装为可复用的 Skill 模块，用于自动投递、网页数据抓取等场景。',
    tags: ['Playwright', '浏览器自动化', 'Skill 封装', 'Python'],
    link: '/projects/automation-skills',
  },
];

const experiences = [
  {
    title: '驻地开发实习生',
    org: '幺米动态科技有限公司',
    period: '2025.07 — 2025.09',
    desc: '参与企业内部业务系统开发与维护，负责需求对接、后端接口开发与测试文档编写。',
  },
];
---

<Layout title="卢嘉淇 · AI 应用开发 & 统计学">
  <!-- Hero -->
  <section class="hero">
    <h1>你好，我是 卢嘉淇 👋</h1>
    <p class="subtitle">
      中国石油大学（北京）克拉玛依校区 · 统计学专业大三在读<br />
      方向：AI 应用开发 / RAG 工程 / 自动化工具
    </p>
    <div class="tags">
      <span class="tag">Python</span>
      <span class="tag">LangChain</span>
      <span class="tag">RAG</span>
      <span class="tag">Playwright</span>
      <span class="tag">Docker</span>
      <span class="tag">桌面自动化</span>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section">
    <h2 class="section-title">精选项目</h2>
    <div class="project-grid">
      {featuredProjects.map((p) => (
        <ProjectCard {...p} />
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section class="section">
    <h2 class="section-title">实习经历</h2>
    {experiences.map((exp) => (
      <div class="experience-item">
        <div class="exp-title">{exp.title}</div>
        <div class="exp-org">{exp.org} · {exp.period}</div>
        <p class="exp-desc">{exp.desc}</p>
      </div>
    ))}
  </section>
</Layout>
