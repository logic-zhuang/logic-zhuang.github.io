---
import Layout from '../layouts/Layout.astro';

const featuredProjects = [
  {
    tag: '实习项目 · 算法调优',
    version: '90+ versions',
    title: '体育中考评测算法二次开发',
    description: '基于开源体育评测算法项目完成本地化二次开发，面向跳远测距与跳绳计数场景。通过 90+ 个版本迭代调参，将跳远测距精度提升至 2 厘米，跳绳计数误差控制在 2 次以内，修复特殊场景识别误判，交付工具已投入团队日常评测使用。',
    highlight: {
      title: '工程闭环',
      value: '设计「调参 → AI 误差分析 → 自动生成新规则 → 回归验证」闭环，Git 版本快照管理，失败版本留档可回溯',
    },
    tags: ['Python', '算法调优', 'OpenCV', '回归验证', 'Git'],
    links: ['实习项目', '精度调优记录'],
  },
  {
    tag: '个人项目 · 自动化技能',
    version: 'OpenDesk 分发',
    title: 'web-rip / desktop-rip Agent 自动化技能',
    description: '独立开发两项 Agent 自动化技能，分别覆盖网页端与桌面应用端。基于 pywin32 COM 驱动 Word / WPS / Excel / Stata 桌面自动化；用 Playwright 完成网页菜单树扫描与操作审核。已打通「Skill 下载 → OpenDesk 使用」链路并交付。',
    highlight: {
      title: '落地合作',
      value: '与当地统计局合作推进「九淇」软件自动化处理落地',
    },
    tags: ['Python', 'pywin32 / COM', 'Playwright', '桌面自动化', 'Skill 开发'],
    links: ['技能说明', '分发链路'],
  },
  {
    tag: '培训项目 · 工程基础',
    version: '2026.03 - 2026.06',
    title: '导师创业小组 · 工程能力培训',
    description: '系统学习 Git 分支管理与远程协作，FastAPI、MySQL 与前端基础；掌握 VS Code Copilot 提示词工程方法（全局 instruction、项目提示词、斜杠命令），并应用于后续算法实习，支撑 90+ 版快速迭代。',
    highlight: {
      title: '掌握能力',
      value: 'Git 协作 / FastAPI 后端 / MySQL 数据库 / 提示词工程',
    },
    tags: ['Git', 'FastAPI', 'MySQL', '提示词工程', '前端基础'],
    links: ['学习记录'],
  },
];

const experiences = [
  {
    title: '驻地开发实习生',
    org: '幺米动态科技有限公司 · 体育中考自动化评测系统',
    period: '2026.07 - 2026.08',
    points: [
      '针对体育中考评测需求，基于开源算法项目完成本地化二次开发，交付工具已投入团队日常评测使用。',
      '持续迭代 90+ 个版本，将跳远测距精度提升至 2 厘米、跳绳计数误差控制在 2 次以内，修复特殊场景识别误判。',
      '设计「调参 → AI 误差分析 → 自动生成新规则 → 回归验证」闭环，配合 Git 版本快照管理，失败版本留档可回溯。',
    ],
    tags: ['Python', '算法调优', 'Git', '回归测试'],
  },
];
---

<Layout title="卢嘉淇 · AI 应用开发工程师">
  <div class="container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-badge">
        <span class="dot"></span>
        <span>正在寻找 AI 应用开发 / 数据分析 / 算法工程实习机会</span>
      </div>
      <h1>你好，我是卢嘉淇</h1>
      <p class="subtitle">
        中国石油大学（北京）克拉玛依校区 · 统计学专业本科在读。具备算法调优与自动化工程复合经历，擅长将实际需求转化为可落地的工具与脚本。
      </p>
      <div class="tags">
        <span class="tag">Python</span>
        <span class="tag">SQL / MySQL</span>
        <span class="tag">Playwright</span>
        <span class="tag">pywin32 / COM</span>
        <span class="tag">Pandas / NumPy</span>
        <span class="tag">Git</span>
        <span class="tag">FastAPI</span>
        <span class="tag">统计分析</span>
      </div>
      <div class="hero-actions">
        <a href="/projects/" class="btn btn-primary">
          <span>查看项目</span>
          <span>→</span>
        </a>
        <a href="/about/" class="btn btn-secondary">
          <span>关于我 / 联系我</span>
        </a>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">精选项目</h2>
          <p class="section-desc">算法调优与自动化工程实践</p>
        </div>
        <a href="/projects/" class="section-link">
          <span>查看全部</span>
          <span>→</span>
        </a>
      </div>
      <div class="project-grid">
        {featuredProjects.map((p) => (
          <div class="project-card">
            <div class="card-header">
              <span class="card-tag">{p.tag}</span>
              <span class="card-version">{p.version}</span>
            </div>
            <h3>{p.title}</h3>
            <p class="card-desc">{p.description}</p>
            <div class="card-highlight">
              <div class="hl-title">✦ {p.highlight.title}</div>
              <div class="hl-value">{p.highlight.value}</div>
            </div>
            <div class="card-tags">
              {p.tags.map((t) => <span>{t}</span>)}
            </div>
            <div class="card-footer">
              {p.links.map((l) => <a href="#">{l}</a>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">实习经历</h2>
        </div>
      </div>
      {experiences.map((exp) => (
        <div class="experience-item">
          <div class="exp-title">{exp.title}</div>
          <div class="exp-org">{exp.org} · {exp.period}</div>
          <ul class="exp-points">
            {exp.points.map((pt) => <li>{pt}</li>)}
          </ul>
          <div class="card-tags" style="margin-top: 16px;">
            {exp.tags.map((t) => <span>{t}</span>)}
          </div>
        </div>
      ))}
    </section>

    <!-- CTA Banner -->
    <section class="cta-banner">
      <div>
        <h3>正在寻找 2025/2026 实习机会</h3>
        <p>方向：AI 应用开发 / 数据分析 / 算法工程。可远程 / 混合办公。</p>
      </div>
      <a href="/about/" class="btn btn-primary">
        <span>联系我 →</span>
      </a>
    </section>
  </div>
</Layout>
