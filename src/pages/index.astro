---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featuredProjects = [
  {
    title: '个人知识库 AI 问答助手',
    description: '基于 LangChain + RAG 架构的私有知识库问答系统。支持多格式文档解析、语义切分、向量检索与多轮对话上下文管理，Docker 容器化部署。',
    tags: ['Python', 'LangChain', 'RAG', 'ChromaDB', 'FastAPI', 'Docker'],
    link: '/projects/ai-knowledge-base',
    highlight: true,
  },
  {
    title: '微网协同调度优化模型',
    description: '构建以日运行成本最小化为目标的线性规划模型，使用 Gurobi 求解器求解微电网与主网协同调度方案，完成灵敏度分析与结果验证。',
    tags: ['线性规划', 'Gurobi', '多目标优化', 'Python', 'NumPy'],
    link: '/projects/power-grid-optimization',
  },
  {
    title: '大模型应用构建 — 冻土消融科普对话',
    description: '基于通义千问 API 构建科普互动对话系统，设计知识图谱式问答路径，编写 Prompt 模板控制专业性与可读性平衡。',
    tags: ['大模型 API', 'Prompt Engineering', '对话系统设计'],
    link: '/projects/robot-competition',
  },
];

const experiences = [
  {
    title: '驻地开发实习生',
    org: '幺米动态科技有限公司',
    period: '2025.07 — 2025.09',
    desc: '参与企业内部业务系统开发与维护，负责需求对接、后端接口开发与测试文档编写。',
  },
];
---

<Layout title="卢嘉淇 · AI 应用开发 & 统计学">
  <!-- Hero -->
  <section class="hero">
    <h1>你好，我是 卢嘉淇 👋</h1>
    <p class="subtitle">
      中国石油大学（北京）克拉玛依校区 · 统计学专业大三在读<br />
      方向：AI 应用开发 / RAG 工程 / 算法建模
    </p>
    <div class="tags">
      <span class="tag">Python</span>
      <span class="tag">LangChain</span>
      <span class="tag">RAG</span>
      <span class="tag">Docker</span>
      <span class="tag">Linux</span>
      <span class="tag">优化算法</span>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section">
    <h2 class="section-title">精选项目</h2>
    <div class="project-grid">
      {featuredProjects.map((p) => (
        <ProjectCard {...p} />
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section class="section">
    <h2 class="section-title">实习经历</h2>
    {experiences.map((exp) => (
      <div class="experience-item">
        <div class="exp-title">{exp.title}</div>
        <div class="exp-org">{exp.org} · {exp.period}</div>
        <p class="exp-desc">{exp.desc}</p>
      </div>
    ))}
  </section>
</Layout>
