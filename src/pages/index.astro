---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featuredProjects = [
  {
    title: '个人知识库 AI 问答助手',
    description: '基于 LangChain + RAG 架构的私有知识库问答系统。支持多格式文档解析、语义切分、向量检索与多轮对话管理，Docker 容器化部署。',
    tags: ['Python', 'LangChain', 'RAG', 'ChromaDB', 'FastAPI', 'Docker'],
    link: '/projects/ai-knowledge-base',
    highlight: true,
  },
  {
    title: 'OpenDesk 平台 Skill 开发',
    description: '基于 OpenDesk 桌面自动化平台，开发可复用的 Skill 模块。涵盖浏览器自动化、网页数据抓取、职位自动投递等场景。',
    tags: ['Playwright', 'Skill 开发', '浏览器自动化', 'Python'],
    link: '/projects/automation-skills',
  },
  {
    title: '微信健身小程序',
    description: '基于微信小程序框架开发的个人健身记录工具，支持训练计划记录、动作库管理与数据统计。',
    tags: ['微信小程序', '前端开发', '数据统计'],
    link: '/projects/fitness-miniprogram',
  },
];

const experiences = [
  {
    title: '驻地开发实习生',
    org: '幺米动态科技有限公司',
    period: '2025.07 — 2025.09',
    desc: '参与企业内部业务系统开发与维护，负责需求对接、后端接口开发与测试文档编写。',
  },
];
---

<Layout title="卢嘉淇 · AI 应用开发 & 统计学">
  <!-- Hero -->
  <section class="hero">
    <h1>你好，我是 卢嘉淇 👋</h1>
    <p class="subtitle">
      中国石油大学（北京）克拉玛依校区 · 统计学专业大三在读<br />
      方向：AI 应用开发 / RAG 工程 / 自动化工具
    </p>
    <div class="tags">
      <span class="tag">Python</span>
      <span class="tag">LangChain</span>
      <span class="tag">RAG</span>
      <span class="tag">Playwright</span>
      <span class="tag">Docker</span>
      <span class="tag">Skill 开发</span>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section">
    <h2 class="section-title">精选项目</h2>
    <div class="project-grid">
      {featuredProjects.map((p) => (
        <ProjectCard {...p} />
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section class="section">
    <h2 class="section-title">实习经历</h2>
    {experiences.map((exp) => (
      <div class="experience-item">
        <div class="exp-title">{exp.title}</div>
        <div class="exp-org">{exp.org} · {exp.period}</div>
        <p class="exp-desc">{exp.desc}</p>
      </div>
    ))}
  </section>
</Layout>
