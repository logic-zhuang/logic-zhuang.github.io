---
import Layout from '../layouts/Layout.astro';

const featuredProjects = [
  {
    tag: '微信小程序',
    version: 'WeChat Mini Program',
    title: '中石克二手物品交易小程序',
    description: '基于微信小程序原生框架开发的校园二手交易平台。包含首页商品浏览、发布帖子、个人中心三个页面，支持商品发布与浏览交互。',
    tags: ['微信小程序', 'WXML/WXSS', 'JavaScript', '前端开发'],
    link: 'https://github.com/logic-zhuang/wechat-secondhand-market',
  },
  {
    tag: 'AI / LangChain 实验',
    version: 'Personal Lab',
    title: 'AI Agent Lab — LangChain 学习实验',
    description: '个人 AI Agent 学习与实验仓库，包含 LangChain 学习笔记与自定义 Agent 脚本实践，探索大模型应用开发的工程化方法。',
    tags: ['Python', 'LangChain', 'AI Agent', 'Prompt Engineering'],
    link: 'https://github.com/logic-zhuang/ai-agent-lab',
  },
  {
    tag: '数据分析 / 优化',
    version: 'Course Project',
    title: '医保统筹基金收支预测与最优缴费标准研究',
    description: '基于新疆医保数据，构建基金收支预测模型，研究最优缴费标准。包含数据处理、预测分析、优化求解与报告生成全流程。',
    tags: ['Python', '数据分析', '预测模型', '优化求解', 'Pandas'],
    link: 'https://github.com/logic-zhuang/medical-insurance-prediction',
  },
];

const experiences = [
  {
    title: '驻地开发实习生',
    org: '幺米动态科技有限公司 · 体育中考自动化评测系统',
    period: '2026.07 - 2026.08',
    points: [
      '基于开源体育评测算法项目完成本地化二次开发，交付工具已投入团队日常评测使用。',
      '持续迭代 90+ 个版本，将跳远测距精度提升至 2 厘米、跳绳计数误差控制在 2 次以内。',
      '设计「调参 → AI 误差分析 → 自动生成新规则 → 回归验证」闭环，Git 版本快照管理。',
    ],
    tags: ['Python', '算法调优', 'Git', '回归测试'],
  },
];
---

<Layout title="卢嘉淇 · AI 应用开发工程师">
  <div class="container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-badge">
        <span class="dot"></span>
        <span>正在寻找 AI 应用开发 / 数据分析实习机会</span>
      </div>
      <h1>你好，我是卢嘉淇</h1>
      <p class="subtitle">
        中国石油大学（北京）克拉玛依校区 · 统计学专业本科在读。具备算法调优与自动化工程经历，擅长将实际需求转化为可落地的工具与项目。
      </p>
      <div class="tags">
        <span class="tag">Python</span>
        <span class="tag">SQL / MySQL</span>
        <span class="tag">Pandas / NumPy</span>
        <span class="tag">LangChain / AI Agent</span>
        <span class="tag">微信小程序</span>
        <span class="tag">Git</span>
        <span class="tag">Playwright</span>
        <span class="tag">统计分析</span>
      </div>
      <div class="hero-actions">
        <a href="/projects/" class="btn btn-primary">
          <span>查看项目</span>
          <span>→</span>
        </a>
        <a href="/about/" class="btn btn-secondary">
          <span>关于我 / 联系我</span>
        </a>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">精选项目</h2>
          <p class="section-desc">独立完成的个人项目与课程实践</p>
        </div>
        <a href="/projects/" class="section-link">
          <span>查看全部</span>
          <span>→</span>
        </a>
      </div>
      <div class="project-grid">
        {featuredProjects.map((p) => (
          <div class="project-card">
            <div class="card-header">
              <span class="card-tag">{p.tag}</span>
              <span class="card-version">{p.version}</span>
            </div>
            <h3>{p.title}</h3>
            <p class="card-desc">{p.description}</p>
            <div class="card-tags">
              {p.tags.map((t) => <span>{t}</span>)}
            </div>
            <div class="card-footer">
              <a href={p.link} target="_blank" rel="noopener">GitHub →</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">实习经历</h2>
        </div>
      </div>
      {experiences.map((exp) => (
        <div class="experience-item">
          <div class="exp-title">{exp.title}</div>
          <div class="exp-org">{exp.org} · {exp.period}</div>
          <ul class="exp-points">
            {exp.points.map((pt) => <li>{pt}</li>)}
          </ul>
          <div class="card-tags" style="margin-top: 16px;">
            {exp.tags.map((t) => <span>{t}</span>)}
          </div>
        </div>
      ))}
    </section>

    <!-- CTA Banner -->
    <section class="cta-banner">
      <div>
        <h3>正在寻找 2025/2026 实习机会</h3>
        <p>方向：AI 应用开发 / 数据分析 / 算法工程。可远程 / 混合办公。</p>
      </div>
      <a href="/about/" class="btn btn-primary">
        <span>联系我 →</span>
      </a>
    </section>
  </div>
</Layout>
