---
import Layout from '../layouts/Layout.astro';

const allProjects = [
  {
    tag: '微信小程序',
    version: 'WeChat Mini Program',
    title: '中石克二手物品交易小程序',
    description: '基于微信小程序原生框架开发的校园二手交易平台。包含首页商品浏览、发布帖子、个人中心三个页面，支持商品发布与浏览交互。使用 WXML/WXSS/JavaScript 原生开发，TabBar 导航，绿色主题配色。',
    tags: ['微信小程序', 'WXML/WXSS', 'JavaScript', '前端开发', 'TabBar'],
    link: 'https://github.com/logic-zhuang/wechat-secondhand-market',
  },
  {
    tag: 'AI / LangChain 实验',
    version: 'Personal Lab',
    title: 'AI Agent Lab — LangChain 学习实验',
    description: '个人 AI Agent 学习与实验仓库。包含 LangChain 学习笔记与自定义 Agent 脚本实践，探索大模型应用开发的工程化方法，从基础概念到实际应用逐步实践。',
    tags: ['Python', 'LangChain', 'AI Agent', 'Prompt Engineering', 'LLM'],
    link: 'https://github.com/logic-zhuang/ai-agent-lab',
  },
  {
    tag: '数据分析 / 优化',
    version: 'Course Project',
    title: '医保统筹基金收支预测与最优缴费标准研究',
    description: '基于新疆医保数据，构建基金收支预测模型，研究最优缴费标准。包含数据处理、预测分析、优化求解与报告生成全流程，使用 Python 进行数据处理与建模分析。',
    tags: ['Python', '数据分析', '预测模型', '优化求解', 'Pandas', 'NumPy'],
    link: 'https://github.com/logic-zhuang/medical-insurance-prediction',
  },
];
---

<Layout title="项目 · 卢嘉淇">
  <div class="container">
    <section class="hero" style="padding-bottom: 32px;">
      <div class="hero-badge">
        <span class="dot"></span>
        <span>PROJECTS</span>
      </div>
      <h1 style="font-size: 36px;">项目</h1>
      <p class="subtitle" style="margin-top: 16px;">
        独立完成的个人项目与课程实践，从前端到数据分析的全栈探索。
      </p>
    </section>

    <div class="project-grid" style="grid-template-columns: 1fr;">
      {allProjects.map((p) => (
        <div class="project-card">
          <div class="card-header">
            <span class="card-tag">{p.tag}</span>
            <span class="card-version">{p.version}</span>
          </div>
          <h3>{p.title}</h3>
          <p class="card-desc">{p.description}</p>
          <div class="card-tags">
            {p.tags.map((t) => <span>{t}</span>)}
          </div>
          <div class="card-footer">
            <a href={p.link} target="_blank" rel="noopener">查看 GitHub 仓库 →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
