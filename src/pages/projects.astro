---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const allProjects = [
  {
    title: '个人知识库 AI 问答助手',
    description: '基于 LangChain + RAG 架构的私有知识库问答系统。支持 PDF/Markdown 文档解析、语义切分、ChromaDB 向量存储、Top-K 语义召回、多轮对话上下文管理，Docker 容器化部署。',
    tags: ['Python', 'LangChain', 'RAG', 'ChromaDB', 'FastAPI', 'Docker'],
    link: '/projects/ai-knowledge-base',
    highlight: true,
  },
  {
    title: 'OpenDesk — 个人桌面工具集',
    description: '面向个人使用场景开发的桌面自动化工具平台。集成浏览器操控、文件批处理、桌面操作等常用能力，采用插件化架构支持自定义扩展，减少重复手动操作。',
    tags: ['Python', '桌面自动化', '插件架构', '工具开发'],
    link: '/projects/opendesk',
  },
  {
    title: '浏览器自动化 & Skill 制作',
    description: '基于 Playwright 与 browser-use 开发浏览器自动化脚本，应用于职位自动投递、网页数据抓取等场景。将通用能力封装为可复用的 Skill 模块，支持快速调用与组合。',
    tags: ['Playwright', '浏览器自动化', 'Skill 封装', 'Python', '自动化投递'],
    link: '/projects/automation-skills',
  },
  {
    title: '微信健身小程序',
    description: '基于微信小程序框架开发的个人健身记录工具，支持训练计划记录、动作库管理与数据统计，前后端完整实现。',
    tags: ['微信小程序', '前端开发', '数据统计'],
    link: '/projects/fitness-miniprogram',
  },
];
---

<Layout title="项目 · 卢嘉淇">
  <h1 style="margin-bottom: 32px;">项目</h1>
  <div class="project-grid">
    {allProjects.map((p) => (
      <ProjectCard {...p} />
    ))}
  </div>
</Layout>
