---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    tag: 'AI 应用 · RAG',
    status: '2026.09 - 至今 · 独立开发',
    title: 'AI Agent 检索问答项目（LangGraph + RAG）',
    summary: '私有知识库问答系统：文档切分、Chroma 向量检索与 BM25+RRF 混合检索，自建小规模评测集做检索效果对照；基于 LangGraph 实现工具调用与会话检查点，支持弱证据场景下的人工确认及恢复；提供 FastAPI 接口与 Streamlit 交互界面。',
    detail: '/projects/ai-knowledge-base/',
    repo: 'https://github.com/logic-zhuang/knowledge-base-rag',
    tags: ['LangGraph', 'Chroma', 'BM25 / RRF', 'FastAPI', 'Streamlit'],
  },
  {
    tag: '自动化 · Agent 技能',
    status: '2026.08 - 2026.09 · 导师创业小组',
    title: '网页与桌面 Agent Skills 开发（web-rip / desktop-rip）',
    summary: '为团队 OpenDesk 应用制作网页与桌面自动化技能：Playwright 网页扫描与操作审核，COM 驱动 Word / WPS / Excel、命令窗口驱动 Stata；技能已配置到团队 OpenDesk 运行，并通过团队开放平台（skill 分发仓）下载安装。',
    detail: '/projects/automation-skills/',
    repo: 'https://github.com/logic-zhuang/agent-skills-automation',
    tags: ['Python', 'Playwright', 'pywin32 / COM', 'Skill 开发'],
  },
  {
    tag: '微信小程序',
    status: '2026.09 - 至今 · 独立开发',
    title: '训练手记 · 健身打卡小程序',
    summary: '以 AI 协作工作流完成的全栈小程序：ChatGPT 写设计与说明文档 → 提示词 + Google Stitch 生成前端 → Agent 按 instruction.md 实现 FastAPI 后端与数据库 → Agent 自动测试（Playwright 模拟真机）→ 人工验收。功能覆盖每周计划、训练打卡、统计与账号同步。',
    detail: '/projects/fitness-miniprogram/',
    repo: 'https://github.com/logic-zhuang/fitness-training-miniprogram',
    tags: ['微信小程序', 'FastAPI', 'AI 工作流', 'Playwright'],
  },
];
---

<Layout title="项目">
  <div class="container">
    <section class="hero" style="padding-bottom: 32px;">
      <div class="hero-badge">
        <span class="dot"></span>
        <span>PROJECTS</span>
      </div>
      <h1 style="font-size: 36px;">项目</h1>
      <p class="subtitle" style="margin-top: 16px;">
        AI 应用与自动化方向的真实实践。每个项目均提供详情页与可访问的 GitHub 仓库。
      </p>
    </section>

    <div class="project-list">
      {projects.map((p) => (
        <div class="project-card project-card-wide">
          <div class="card-header">
            <span class="card-tag">{p.tag}</span>
            <span class="card-version">{p.status}</span>
          </div>
          <h3>{p.title}</h3>
          <p class="card-desc">{p.summary}</p>
          <div class="card-tags">
            {p.tags.map((t) => <span>{t}</span>)}
          </div>
          <div class="card-footer">
            <a href={p.detail}>项目详情 →</a>
            <a href={p.repo} target="_blank" rel="noopener">GitHub 仓库 →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
