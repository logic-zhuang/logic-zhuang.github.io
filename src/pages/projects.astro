---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const allProjects = [
  {
    title: '个人知识库 AI 问答助手',
    description: '基于 LangChain + RAG 架构的私有知识库问答系统。支持 PDF/Markdown 文档解析、语义切分、ChromaDB 向量存储、Top-K 语义召回、多轮对话上下文管理，Docker 容器化部署。',
    tags: ['Python', 'LangChain', 'RAG', 'ChromaDB', 'FastAPI', 'Docker'],
    link: '/projects/ai-knowledge-base',
    highlight: true,
  },
  {
    title: 'OpenDesk 平台 Skill 开发',
    description: '基于 OpenDesk 桌面自动化平台，开发可复用的 Skill 模块。涵盖浏览器自动化、网页数据抓取、职位自动投递等场景，将通用操作封装为标准化 Skill 接口。',
    tags: ['Playwright', 'Skill 开发', '浏览器自动化', 'Python', '自动化投递'],
    link: '/projects/automation-skills',
  },
  {
    title: '微信健身小程序',
    description: '基于微信小程序框架开发的个人健身记录工具，支持训练计划记录、动作库管理与数据统计，前后端完整实现。',
    tags: ['微信小程序', '前端开发', '数据统计'],
    link: '/projects/fitness-miniprogram',
  },
];
---

<Layout title="项目 · 卢嘉淇">
  <h1 style="margin-bottom: 32px;">项目</h1>
  <div class="project-grid">
    {allProjects.map((p) => (
      <ProjectCard {...p} />
    ))}
  </div>
</Layout>
