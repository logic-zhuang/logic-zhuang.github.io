---
import Layout from '../layouts/Layout.astro';

const allProjects = [
  {
    tag: '微信小程序',
    version: 'WeChat Mini Program',
    title: '训练手记 · 健身打卡小程序',
    description: '个人健身记录微信小程序，支持训练计划制定、训练打卡、历史记录查看、个人数据统计。包含首页、计划管理、训练记录、历史记录、个人中心等完整页面，使用微信原生框架开发。',
    tags: ['微信小程序', 'WXML/WXSS', 'JavaScript', '前端开发', 'TabBar 导航'],
    link: 'https://github.com/logic-zhuang/fitness-training-miniprogram',
  },
  {
    tag: '自动化技能开发',
    version: 'Agent Skills',
    title: 'Agent 自动化技能开发',
    description: '独立开发 web-rip、desktop-rip 等 Agent 自动化技能，覆盖网页端与桌面应用端。基于 pywin32 COM 驱动 Word / WPS / Excel / Stata 桌面自动化；用 Playwright 完成网页菜单扫描与操作审核。技能已接入分发链路。',
    tags: ['Python', 'pywin32 / COM', 'Playwright', '桌面自动化', '网页自动化', 'Skill 开发'],
    link: 'https://github.com/logic-zhuang/agent-skills-automation',
  },
  {
    tag: 'RAG / 知识库',
    version: 'Knowledge Base',
    title: '知识库 RAG 问答系统',
    description: '基于 LangChain + ChromaDB 的个人知识库问答系统，支持文档上传、向量索引、语义检索与问答。包含知识库构建脚本、数据处理与查询接口，实现从文档到问答的完整 RAG 流程。',
    tags: ['Python', 'LangChain', 'ChromaDB', 'RAG', '向量检索', '语义搜索'],
    link: 'https://github.com/logic-zhuang/knowledge-base-rag',
  },
];
---

<Layout title="项目 · 卢嘉淇">
  <div class="container">
    <section class="hero" style="padding-bottom: 32px;">
      <div class="hero-badge">
        <span class="dot"></span>
        <span>PROJECTS</span>
      </div>
      <h1 style="font-size: 36px;">项目</h1>
      <p class="subtitle" style="margin-top: 16px;">
        独立完成的个人项目，从前端小程序到 AI 应用开发的全栈实践。
      </p>
    </section>

    <div class="project-grid" style="grid-template-columns: 1fr;">
      {allProjects.map((p) => (
        <div class="project-card">
          <div class="card-header">
            <span class="card-tag">{p.tag}</span>
            <span class="card-version">{p.version}</span>
          </div>
          <h3>{p.title}</h3>
          <p class="card-desc">{p.description}</p>
          <div class="card-tags">
            {p.tags.map((t) => <span>{t}</span>)}
          </div>
          <div class="card-footer">
            <a href={p.link} target="_blank" rel="noopener">查看 GitHub 仓库 →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
