---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: '首页' },
  { href: '/projects/', label: '项目' },
  { href: '/skills/', label: '技能' },
  { href: '/about/', label: '关于我' },
];
---

<header class="site-header">
  <nav class="nav container" aria-label="主导航">
    <div class="nav-brand">
      <a href="/" class="nav-brand-link" aria-label="返回首页">
        <div class="nav-avatar">卢</div>
        <div class="nav-name">
          <span class="name">卢嘉淇</span>
          <span class="title">Jiaqi Lu · AI Dev</span>
        </div>
      </a>
      <div class="nav-badge">
        <span class="dot"></span>
        <span>求职 / 研究生申请中</span>
      </div>
    </div>
    <ul class="nav-links">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : ''}
            aria-current={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
